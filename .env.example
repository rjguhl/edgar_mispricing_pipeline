# EDGAR Mispricing Pipeline — environment variables
# Copy to .env and fill in your credentials. Never commit .env.

# --- API keys ---
ANTHROPIC_API_KEY=
FRED_API_KEY=

# --- Pipeline behavior ---
MISPRICING_THRESHOLD=0.10

# --- EDGAR ---
# SEC requires a descriptive User-Agent with contact email on every request.
EDGAR_USER_AGENT=EDGAR Mispricing Pipeline rjguhl@example.com
SP500_TICKERS_PATH=data/sp500_tickers.csv

# --- Dev mode ---
# When true, ingestion clients read from data/fixtures/ instead of hitting live APIs.
# Lets the entire pipeline run end-to-end without any credentials.
USE_FIXTURES=true
FIXTURES_DIR=data/fixtures
